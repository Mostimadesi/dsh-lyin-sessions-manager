{
  "name": "dsh-lyin-sessions-manager",
  "description": "DSH 会话管理插件（TOBYCAI/dsh-sessions-manager 的个人分支）：设置面板 + 侧栏双入口，归档 / 恢复 / 跨工作区移动 / 回收站（可恢复、批量清空、自动清理），子代理折叠与血缘、删父会话连带子代理，空白会话识别，按标题 · ID · 工作区搜索，带磁盘占用与会话详情。本分支另加「进行中的会话」快捷访问面板（侧栏入口 + 右栏标签页）、顶部摘要条 / 最近活跃 / 已标记三个次级维度、可收起分组与吸顶标题。已适配 DSH 0.2.2-rc.1。Session manager plugin for DeepSeek Harness (personal fork of TOBYCAI/dsh-sessions-manager) with a quick-access sessions-in-progress panel (sidebar entry + right-rail tab), summary bar / recent activity / marked sections, collapsible groups and a sticky header (0.2.2-rc.1 ready).",
  "version": "3.10.2",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "session-manager",
    "archived-sessions",
    "session"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mostimadesi/dsh-lyin-sessions-manager.git"
  },
  "homepage": "https://github.com/Mostimadesi/dsh-lyin-sessions-manager#readme",
  "bugs": {
    "url": "https://github.com/Mostimadesi/dsh-lyin-sessions-manager/issues"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/run-tests.mjs",
    "check:dist": "npm run build && git diff --exit-code -- lib",
    "check:sessions": "node scripts/check-session-health.mjs",
    "prepack": "node build.mjs",
    "check:runtime": "node scripts/compat-runtime.mjs ${DSH_RUNTIME:-$HOME/.dsh/runtime}"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session-query": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.0": true
  }
}
